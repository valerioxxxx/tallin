/* ---------- Projection helper ---------- */
function proj(b, W){
  var k = Math.cos((b.minLat+b.maxLat)/2*Math.PI/180);
  var w = (b.maxLon-b.minLon)*k, h = b.maxLat-b.minLat, H = W*h/w;
  return {W:W,H:H,k:k,p:function(lon,lat){return [(lon-b.minLon)*k/w*W,(b.maxLat-lat)/h*H];}};
}
function poly(P, pts){return pts.map(function(q){var xy=P.p(q[0],q[1]);return xy[0].toFixed(1)+","+xy[1].toFixed(1);}).join(" ");}
function pathD(P, pts, smooth){
  var xy = pts.map(function(q){return P.p(q[0],q[1]);});
  if(!smooth) return "M"+xy.map(function(a){return a[0].toFixed(1)+" "+a[1].toFixed(1);}).join(" L");
  var d="M"+xy[0][0].toFixed(1)+" "+xy[0][1].toFixed(1);
  for(var i=1;i<xy.length;i++){var m=[(xy[i-1][0]+xy[i][0])/2,(xy[i-1][1]+xy[i][1])/2];d+=" Q"+xy[i-1][0].toFixed(1)+" "+xy[i-1][1].toFixed(1)+" "+m[0].toFixed(1)+" "+m[1].toFixed(1);}
  var L=xy[xy.length-1]; return d+" L"+L[0].toFixed(1)+" "+L[1].toFixed(1);
}

