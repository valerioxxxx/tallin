 {k:"Voli",d:"Wizz Air Roma → Tallinn €55 e Ryanair Vilnius → Roma €60, solo zaino.",v:[115,115,115]},
 {k:"Cibo e bevande",d:"Cinque giorni: colazioni e 2 cene in appartamento (giovedì a Tallinn, sabato a Vilnius), pranzi ai mercati, Folkklubs a Riga, cena lituana a Vilnius, vin brulé ai mercatini.",v:[120,160,215]},
 {k:"Esperienze e ingressi",d:"Löyly €29, celle KGB €8–10 (sconto studenti), terrazza di Riga €8, Temppeliaukio, pattinaggio con noleggio.",v:[62,70,80]},
 {k:"Traghetti Tallinn ↔ Helsinki",d:"Prezzo reale: €35 andata e ritorno (7:30 e 19:30).",v:[35,35,35]},
 {k:"Trasporti locali",d:"Aeroporto di Tallinn, giornaliero HSL a Helsinki, tram, bus 88 per l'aeroporto di Vilnius.",v:[18,24,35]},
 {k:"Bus Tallinn → Riga",d:"€16,98 già pagati, più l'eventuale differenza per spostarlo a venerdì.",v:[16.98,20,25]},
 {k:"Bus Riga → Vilnius",d:"Prezzo reale: FlixBus di sabato alle 6:15.",v:[17,17,17]},
 {k:"Imprevisti e assicurazione",d:"Margine per il transfer notturno per Fiumicino, bagagli extra, polizza viaggio.",v:[20,35,50]}
];
function val(r){return r.fixedTotal? r.v[bstate.s]/bstate.n : r.v[bstate.s];}
var SC=["Risparmio","Medio","Comodo"], bstate={n:8,s:1};
var scen=document.getElementById("scen");
scen.innerHTML=SC.map(function(s,i){return '<button type="button" data-s="'+i+'">'+s+'</button>';}).join("");
scen.addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;bstate.s=+b.dataset.s;renderBud();});
document.getElementById("minus").addEventListener("click",function(){bstate.n=Math.max(6,bstate.n-1);renderBud();});
document.getElementById("plus").addEventListener("click",function(){bstate.n=Math.min(20,bstate.n+1);renderBud();});
var eur=function(x){return "€"+Math.round(x).toLocaleString("it-IT");};
function renderBud(){
  [].forEach.call(scen.children,function(b){b.setAttribute("aria-pressed",+b.dataset.s===bstate.s);});
  document.getElementById("people").textContent=bstate.n;
  document.getElementById("minus").disabled=bstate.n<=6;
  var tot=0,max=0; BUD.forEach(function(r){var v=val(r);tot+=v;max=Math.max(max,r.fixedTotal?v:r.v[2]);});
  document.getElementById("ppTot").textContent=eur(tot);
  document.getElementById("grpTot").textContent="Gruppo di "+bstate.n+": "+eur(tot*bstate.n);
  document.getElementById("rows").innerHTML=BUD.map(function(r){var v=val(r);
    var extra=r.fixedTotal?" Totale fisso "+eur(r.v[0])+", qui diviso per "+bstate.n+".":" Intervallo: "+eur(r.v[0])+"–"+eur(r.v[2])+".";
    return '<div class="row"><b>'+esc(r.k)+'</b><span class="v num">'+eur(v)+'</span><div class="bar"><i style="width:'+Math.min(100,v/max*100).toFixed(1)+'%"></i></div><p>'+esc(r.d)+extra+'</p></div>';
  }).join("");
}
renderBud();
})();
</script>
